<Window x:Class="ToastDeckA.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ToastDeck Notification"
        Width="380"
        Height="150"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        Background="Transparent"
        AllowsTransparency="True">
    <Border Margin="8"
            Padding="18"
            Background="#FFFFFF"
            BorderBrush="#C9D1DF"
            BorderThickness="1"
            CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18"
                              ShadowDepth="4"
                              Direction="270"
                              Color="#66000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="{Binding Title}"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="#111827"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Row="1"
                       Text="{Binding Message}"
                       Margin="0,8,0,10"
                       Foreground="#4B5563"
                       TextWrapping="Wrap"
                       MaxHeight="44" />
            <DockPanel Grid.Row="2">
                <TextBlock Text="{Binding CreatedAtLocalText}"
                           VerticalAlignment="Center"
                           Foreground="#6B7280" />
                <Button DockPanel.Dock="Right"
                        MinWidth="84"
                        Height="30"
                        Padding="12,0"
                        HorizontalAlignment="Right"
                        Click="DismissButton_Click">
                    Dismiss
                </Button>
            </DockPanel>
        </Grid>
    </Border>
</Window>
