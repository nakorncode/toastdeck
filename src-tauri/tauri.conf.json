{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ToastDesk",
  "version": "0.2.0",
  "identifier": "com.nakorncode.toastdesk.v2",
  "mainBinaryName": "ToastDesk",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "toast",
        "title": "ToastDesk",
        "width": 440,
        "height": 520,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "NakornCode",
    "resources": [
      "../assets/sounds/aosp-acrux.wav",
      "../assets/sounds/aosp-adara.wav",
      "../assets/sounds/aosp-altair.wav",
      "../assets/sounds/aosp-alya.wav",
      "../assets/sounds/aosp-antares.wav",
      "../assets/sounds/aosp-argon.wav",
      "../assets/sounds/aosp-capella.wav",
      "../assets/sounds/aosp-vega.wav"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "ToastDesk"
      }
    }
  }
}
