{
  "name": "toastdesk",
  "version": "0.2.0",
  "description": "Persistent Windows notifications you cannot miss.",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "pnpm typecheck && pnpm lint && pnpm build",
    "serve": "vite preview",
    "tauri": "node ./scripts/with-cargo.mjs",
    "overlay:layout-loop": "node ./scripts/overlay-layout-loop.mjs",
    "native:toast-loop": "node ./scripts/native-toast-loop.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2",
    "solid-js": "^1.9.3",
    "solid-sonner": "^0.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "eslint": "^10.5.0",
    "playwright": "^1.62.1",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^6.0.3",
    "vite-plugin-solid": "^2.11.0"
  }
}
